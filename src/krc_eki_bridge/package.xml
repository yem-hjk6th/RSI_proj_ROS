<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>krc_eki_bridge</name>
  <version>0.1.0</version>
  <description>EthernetKRL bridge for a KR C4 without RSI: KrcState out, OverrideCmd in, same safety rules as krc_rsi_bridge. Controller-side templates are NOT RUN.</description>
  <maintainer email="183082151+yem-hjk6th@users.noreply.github.com">yem-hjk6th</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>krc_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>krc_rsi_bridge</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
