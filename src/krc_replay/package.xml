<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>krc_replay</name>
  <version>0.1.0</version>
  <description>End-to-end replay of a logged session through the ROS graph: log_player node, lock-step and real-time launch files, equivalence and safety tests.</description>
  <maintainer email="183082151+yem-hjk6th@users.noreply.github.com">yem-hjk6th</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>krc_interfaces</exec_depend>
  <exec_depend>krc_rsi_bridge</exec_depend>
  <exec_depend>krc_sim</exec_depend>
  <exec_depend>cl_controller</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pandas</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>width_readout_elp</test_depend>
  <test_depend>python3-opencv</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
