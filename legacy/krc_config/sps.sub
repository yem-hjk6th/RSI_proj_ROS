&ACCESS RVO
&REL 12
&COMMENT PLC on control
DEF  SPS ( )
   ;FOLD DECLARATIONS
      ;FOLD BASISTECH DECL
         ;Automatik extern
         DECL STATE_T STAT
         DECL MODUS_T MODE
      ;ENDFOLD (BASISTECH DECL)
      ;FOLD USER DECL
         ; Please insert user defined declarations
         DECL REAL EffectiveRPM
      ;ENDFOLD (USER DECL)
   ;ENDFOLD (DECLARATIONS)
   ;FOLD INI
      ;FOLD AUTOEXT INIT
         INTERRUPT DECL 91 WHEN $PRO_STATE1==#P_FREE DO RESET_OUT ()
         INTERRUPT ON 91
         INTERRUPT DECL 92 WHEN $PRO_MOVE==TRUE DO RESET_LINESEL()
         INTERRUPT ON 92
         $LOOP_MSG[]="                                                            "
         MODE=#SYNC
         $H_POS=$H_POS
         ;Automatik extern
         IF $MODE_OP==#EX THEN
            CWRITE($CMD,STAT,MODE,"RUN /R1/CELL()")
         ENDIF
      ;ENDFOLD (AUTOEXT INIT)
      ;FOLD BACKUPMANAGER PLC INIT
         BM_ENABLED = FALSE
         BM_OUTPUTVALUE = 0
      ;ENDFOLD (BACKUPMANAGER PLC INIT)
      ;FOLD TQM_INIT
         TorqueDefinitions()
      ;ENDFOLD (TQM_INIT)
      ;FOLD USER INIT
         ; Please insert user defined initialization commands
         
         ; Ensure the global RPM variable is set to 0 on startup.
         PelletExtruderRPM = 0
         
      ;ENDFOLD (USER INIT)
   ;ENDFOLD (INI)
   
   LOOP
      WAIT FOR NOT($POWER_FAIL)
      TORQUE_MONITORING()
      ;FOLD BACKUPMANAGER PLC
         IF BM_ENABLED THEN
            BM_OUTPUTSIGNAL = BM_OUTPUTVALUE
         ENDIF
      ;ENDFOLD (BACKUPMANAGER PLC)
      ;START AUTOGENERATED -- DO NOT CHANGE -- GripperSpotTech sps SpsSub.add InsertGripperTechGlobals
      ;FOLD GRIPPERTECH LOOP
         GRPg_ChkSetStatePLC()
      ;ENDFOLD (GRIPPERTECH LOOP)
      ;END AUTOGENERATED -- DO NOT CHANGE -- (GripperSpotTech sps SpsSub.add InsertGripperTechGlobals)
      ;FOLD USER PLC
         
         ;FOLD USER LOGIC FOR PELLET EXTRUDER CONTROL
            ;this section reads global RPM setpoint and converts it to scaled analog output for extruder motor controller (arduino)
            
            ; Extruder priming rising edge: turns ON while program is NOT running with key press
            ; copy last effective RPM into ManualRPM (else leave ManualRPM as its initial 250.0)
            IF (NOT $PRO_ACT) THEN
               IF (bManualActive AND (NOT bManualPrev)) THEN
                  IF LastRPM > 0.0 THEN
                     ManualRPM = LastRPM
                  ENDIF
               ENDIF
            ENDIF
            
            ;detecting status key presses to modify extrusion trim (adjustment)
            IF bTrimPlusReq THEN
               TrimRPM = TrimRPM + StepSizeRPM
               bTrimPlusReq = FALSE
            ENDIF
            IF bTrimMinusReq THEN
               TrimRPM = TrimRPM - StepSizeRPM
               bTrimMinusReq = FALSE
            ENDIF
            IF bTrimResetReq THEN
               TrimRPM = 0.0
               bTrimResetReq = FALSE
            ENDIF
            
            ; AUTO PAUSE/RESUME EXTRUSION
            IF $PRO_ACT THEN
               ; Program running: program command + live trim
               EffectiveRPM = PelletExtruderRPM + TrimRPM
               
               ; Resume from pause: restore immediately to last effective RPM
               IF NOT bPro_ActPrev THEN
                  EffectiveRPM = LastRPM
               ENDIF
               
               ; Track for future resumes; Priming is off while program runs
               LastRPM       = EffectiveRPM
               bManualActive = FALSE
               
            ELSE
               ; Program NOT running: PRIME enables manual extrude (deadman gate via safety)
               IF bManualActive AND $PERI_RDY THEN
                  EffectiveRPM = ManualRPM
               ELSE
                  EffectiveRPM = 0.0
               ENDIF
            ENDIF
            
            ; Ensure RPM is within 0-840 valid range
            IF EffectiveRPM < 0.0   THEN 
               EffectiveRPM = 0.0   
            ENDIF
            IF EffectiveRPM > 840.0 THEN 
               EffectiveRPM = 840.0 
            ENDIF
            EffectiveRPM_mon = EffectiveRPM ;just for monitoring purposes

            ; === OUTPUT PROPORTIONAL VOLTAGE ===
            PelletExtruderVoltage = (EffectiveRPM / MAX_RPM) * MAX_VOLTAGE
            
            ;This ensures Arduino can't get fried
            IF PelletExtruderVoltage > 0.5 THEN ;Max Analog Output
               PelletExtruderVoltage=0.5
            ENDIF
            IF PelletExtruderVoltage < 0 THEN ;Dont set below 0
               PelletExtruderVoltage=0
            ENDIF
            
            ; Edge detectors - for stop/resume and manual logic
            bPro_ActPrev  = $PRO_ACT
            bManualPrev   = bManualActive
            
         ;ENDFOLD (USER LOGIC FOR PELLET EXTRUDER CONTROL)
         
         ;FOLD ===OTHER ANALOG OUTPUT PROTECTIONS===
            ;ensuring AO2, AO3, and A04 never exceed 5V (assuming using an Arduino or similar)
            IF AnalogOut2 > MaxAnalog2 THEN ;Max Analog Output
               AnalogOut2=MaxAnalog2
            ENDIF
            IF AnalogOut2 < 0 THEN ;Dont set below 0
               AnalogOut2=0
            ENDIF
            
            IF AnalogOut3 > MaxAnalog3 THEN ;Max Analog Output
               AnalogOut3=MaxAnalog3
            ENDIF
            IF AnalogOut3 < 0 THEN ;Dont set below 0
               AnalogOut3=0
            ENDIF
            
            IF AnalogOut4 > MaxAnalog4 THEN ;Max Analog Output
               AnalogOut4=MaxAnalog4
            ENDIF
            IF AnalogOut4 < 0 THEN ;Dont set below 0
               AnalogOut4=0
            ENDIF
         ;ENDFOLD ===OTHER ANALOG OUTPUT PROTECTIONS===
         
         ;FOLD ===VEL_EXTR
            $SEN_PREA[1] = $VEL_ACT
            $SEN_PREA[2] = EffectiveRPM_mon
         ;ENDFOLD ===VEL_EXTR
         
      ;ENDFOLD (USER PLC)
   ENDLOOP
   
END

DEF  RESET_OUT ( )
   INT N
   MsgLoop(" ")
   IF REFLECT_PROG_NR == 1 THEN
      FOR N = 0 TO PGNO_LENGTH - 1
         $OUT[PGNO_FBIT_REFL + N] = FALSE
      ENDFOR
   ENDIF
   IF (PGNO_REQ>0) THEN
      $OUT[PGNO_REQ]=FALSE
   ELSE
      IF (PGNO_REQ<0) THEN
         $OUT[-PGNO_REQ]=TRUE
      ENDIF
   ENDIF
END

DEF RESET_LINESEL()
   $LINE_SEL_OK=FALSE
END
;FOLD USER SUBROUTINE
   ; Integrate your user defined subroutines
   
;ENDFOLD (USER SUBROUTINE)
