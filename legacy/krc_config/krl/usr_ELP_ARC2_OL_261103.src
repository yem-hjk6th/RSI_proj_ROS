&ACCESS RVP
&REL 1
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM EDITMASK = *
DEF usr_ELP_ARC2_OL_261103 ( )
;==========================================================================
; usr_ELP_ARC2_OL_261103 - DRAFT, NOT RUN, NOT REVIEWED BY THE USER. lab laptop, 2026-11-03 ~23:00 (for 11-04).
;   Semicircle meander ARC2 (user 11-03: 'semicircles joined, each unit >= 180 deg'): every lobe sweeps
;   the tangent 180 deg, for the angle map of bore1 / bore2 / ELP. Supersedes ARC1 (user: not satisfied). ONE src for both:
;   OL = realtime_cl_cage2_261102 run_cl.py --mode prep --prep-ovcmd 40 (OvCmd 40 in every RSI reply);
;   CL = realtime_cl_cage2_semi_261103 run_cl.py --mode closed --ov-outside 40 (OvCmd 40 outside the print
;   window, 12..100 inside). Generated by realtime_cl_cage2_semi_261103/pattern/make_arc2_261103.py.
;   Lobes + straight lines $VEL.CP 0.030 -> 12 mm/s at OvCmd 40 (30 at 100); connectors 0.024 -> 9.6 mm/s at 40.
; FRAME = usr_ELP_FAN1_OL_261103.src line for line (= the CLp4 frame): tool 3, base 0, INI, home PTP, RPM 0
;   before RSI, RSI_CREATE / RSI_ON (RSI_OV4), hover PTP (1025, -530, 60) S 'B110', WAIT SEC 0, 400 rpm,
;   WAIT SEC 4, 120 rpm, descent at X 1025, wipe-in along -X at Y -530, RSI_OFF after the last line, rpm 0,
;   wipe-out +X past the bed edge, lift, travel at Z ~62 to the 10-06 end pose, home PTP. Only the print
;   section and the wipe-out Y (-304.58, FAN1 -494.31) differ.
; GEOMETRY: tool A 0 B 90 C 0 on every point (no tool rotation). Z = z_cmd(x) of the CLp pattern json
;   (0.8 + 1.5 (x - 600) / 370). Lead A0 X 945 -> 790 at Y -530 (= FAN1), then 4 rows of semicircles
;   between X 790 and 945, joined by +Y connectors (tangent-continuous: every row starts / ends along +Y):
;   B19 (+X, 4 lobes R 19.375, baseline Y -491.38), A19 (-X, 4 x R 19.375, Y -433.38),
;   B13 (+X, 6 x R 12.917, Y -381.83), A13 (-X, 6 x R 12.917, Y -336.75), then the straight
;   B0_end X 790 -> 945 at Y -304.58. Lobes alternate +Y / -Y of the row baseline; each lobe's tangent sweeps
;   180 deg. Bead edges of different rows 14 mm apart. Chords: R 19.38 16 per lobe x 3.80 mm
;   (sag 0.093), R 12.92 13 x 3.11 mm (sag 0.094), C_DIS (CLp4 legs = 9.2 mm
;   chords, ARC1 5.2 mm). Print XY inside X 790..945, Y -530..-301.95 (CLp box
;   X 770..1025, Y -530..-275). Print length 1509 mm, ~130 s at OvCmd 40.
;   Path / chord list: usr_ELP_ARC2_261103_segs.csv, usr_ELP_ARC2_261103_chords.csv (pattern folder of the semi copy).
; MOTION REPORT (feedback-motion-alarm-rules): M1 hover PTP = the CLp motion (approved exception), at OvCmd
;   40; prints <= 12 mm/s at OvCmd 40 (<= 30 at 100), travel 30 mm/s. M2: new XY = the 4 lobe rows, the
;   connectors at X 790 / 945, B0_end at Y -304.58 and the wipe-out at Y -304.58 (CLp: -275, FAN1:
;   -494.31), all inside the CLp XY hull. M3: none (Z = CLp Z law, RSI moves no position). Corners: chord to
;   chord 11.25 deg (R 19.4) / 13.85 deg (R 12.9), 0 at the lobe joints, about half a step at the
;   connector joints, 90 deg at lead -> connector and connector -> B0_end (FAN1 hops 90).
; THE PENDANT OVERRIDE IS OVERWRITTEN EVERY 4 ms FROM RSI_ON TO RSI_OFF. Preview / pendant must read 40 in
;   the first 2 s after Start; anything else -> STOP (a 100 reply = 30 mm/s lines).
;==========================================================================
DECL INT OV_SAVED
DECL INT ret
DECL INT CONTID

;FOLD INI
BAS (#INITMOV,0 )
;BASE IS 0, TOOL IS 3, FIXED START POS
BAS(#TOOL, 3)
BAS(#BASE, 0)
BAS(#VEL_PTP, 10)
PDAT_ACT.ACC = 50
PDAT_ACT.APO_DIST = 50
$BWDSTART = TRUE
$VEL.CP=0.2
$ADVANCE=3
;ENDFOLD (INI)

OV_SAVED=$OV_PRO

PTP  {A1 33,A2 -90,A3 100,A4 5,A5 -10,A6 -5,E1 0,E2 0,E3 0,E4 0}

;EXTRUDER STOPPED UNTIL THE HOVER PURGE
PelletExtruderRPM = 0

;RSI INI
ret = RSI_CREATE("RSI_OV4.rsi", CONTID, TRUE)
IF (ret <> RSIOK) THEN
    HALT
ENDIF

ret = RSI_ON(#RELATIVE)
IF (ret <> RSIOK) THEN
    HALT
ENDIF

;PURGE HOVER PAST THE BED'S MAX X (= CLp4 L89-L96)
PTP {X 1025.0, Y -530.0, Z 60, A 0, B 90, C -0, E1 0, E2 0, E3 0, E4 0, S 'B110'}
WAIT SEC 0
PelletExtruderRPM = 400
WAIT SEC 4
PelletExtruderRPM = 120
;DESCENT + WIPE-IN: 0.030 AT OVCMD 40 = 12 mm/s (CLp4 0.012 AT 100 = 12 mm/s)
$VEL.CP=0.030
LIN {X 1025.0, Y -530.0, Z 2.52, A 0, B 90, C -0, E1 0, E2 0, E3 0, E4 0} C_DIS
LIN {X 945.0, Y -530.0, Z 2.20, A 0, B 90, C -0, E1 0, E2 0, E3 0, E4 0} C_DIS

;PRINT SECTION ARC2 (one $VEL.CP before every LIN; comment = segs row, chord)
$VEL.CP=0.030
LIN {X 790.00, Y -530.00, Z 1.57, A 0, B 90, C -0, E1 0, E2 0, E3 0, E4 0} C_DIS ;seg 1 A0_lead c01/1
$VEL.CP=0.024
LIN {X 790.00, Y -491.38, Z 1.57, A 0, B 90, C -0, E1 0, E2 0, E3 0, E4 0} C_DIS ;seg 2 connector c01/1
$VEL.CP=0.030
LIN {X 790.37, Y -487.60, Z 1.57, A 0, B 90, C -0, E1 0, E2 0, E3 0, E4 0} C_DIS ;seg 3 B19L1 c01/16
